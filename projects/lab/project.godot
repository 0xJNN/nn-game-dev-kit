; Pinned toolchain: tools.lock.json. This is a starter, not a scientific simulator.
config_version=5

[application]
config/name="Novanode Lab"
run/main_scene="res://scenes/lab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A small interactive lab for validating the Novanode production pipeline."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.075, 1)
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
