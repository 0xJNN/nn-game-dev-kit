{
  "id": "replace-with-feature-id",
  "goal": "Replace this template with one approved deliverable, not an open-ended improvement loop.",
  "inputs": ["docs/BRIEF.md", "docs/STYLE.md"],
  "allowed_writes": ["projects/NovanodeLab/Source", "projects/NovanodeLab/Config"],
  "acceptance": ["Replace with measurable outcomes and evidence requirements."],
  "limits": {
    "deadline_seconds": 1800,
    "command_timeout_seconds": 180,
    "max_attempts": 2,
    "budget_usd": "0.00"
  },
  "resource": "integrator",
  "steps": [
    {"name": "Not configured: review and replace argv", "argv": ["{python}", "-c", "raise SystemExit('Configure this contract before execution')"]}
  ],
  "verification": [
    {"name": "Native Unreal tests", "argv": ["{python}", "studio.py", "unreal", "test", "--execute"]}
  ]
}
